# Copy to .env.local for local development. Never commit real values.

# "mock" runs the built-in HelcimPay simulator (no Helcim account needed).
# "live" uses the real Helcim API. Defaults to "live" when HELCIM_API_TOKEN is
# set, otherwise "mock".
HELCIM_MODE=mock

# Required for live mode: your Helcim API token (Helcim dashboard → Integrations → API Access).
HELCIM_API_TOKEN=

# At least 32 random characters. Encrypts the per-checkout cookie holding the secret token.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHECKOUT_COOKIE_SECRET=

# At least 32 random characters. Signs simulator checkout tokens (mock mode only).
MOCK_SIGNING_SECRET=
